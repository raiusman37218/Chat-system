# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://vfjsaynnubxywdbevxtx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudinary Configuration (For Chat Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Platform Help Center Base Domain (Wildcard: *.chatifyhelp.com)
HELP_BASE_DOMAIN=chatifyhelp.com
NEXT_PUBLIC_HELP_BASE_DOMAIN=chatifyhelp.com

# Base App URL for callbacks, redirects, and emails
NEXT_PUBLIC_APP_URL=https://zen-try.com

# Shared secret Vercel Cron sends to /api/cron/* routes (Authorization: Bearer ...)
CRON_SECRET=generate_a_long_random_string

# Channels (WhatsApp Business Cloud API) — see CLAUDE.md "Channels"
# 32 random bytes that encrypt channel tokens at rest: openssl rand -base64 32
CHANNEL_ENCRYPTION_KEY=
# Graph API version for WhatsApp calls (default v23.0)
META_GRAPH_API_VERSION=v23.0
# Platform Meta app, needed for Embedded Signup and the shared webhook URL
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration id for WhatsApp Embedded Signup
META_WHATSAPP_CONFIG_ID=
# Verify token you enter in the Meta app's webhook settings for /api/channels/whatsapp/webhook
META_WEBHOOK_VERIFY_TOKEN=

# Instagram (Instagram API with Instagram Login) — see CLAUDE.md "Channels"
# The Instagram app's id/secret (Meta app → Instagram → API setup with Instagram login).
# Needed for "Sign in with Instagram" and the shared webhook /api/channels/instagram/webhook.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Verify token you enter in the Instagram webhook settings
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Set to true only once Meta has approved the Human Agent feature for the app
INSTAGRAM_HUMAN_AGENT_ENABLED=false
# Optional, default v23.0
INSTAGRAM_GRAPH_API_VERSION=v23.0
